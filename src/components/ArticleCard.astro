---
interface Props {
  title: string;
  slug: string;
  image?: string;
  altText?: string;
  category?: string;
  excerpt?: string;
}
const { title, slug, image, altText, category, excerpt } = Astro.props;
---
<a class="card" href={`/articles/${slug}/`}>
  <div class="card-thumb">
    {image
      ? <img src={image} alt={altText || title} loading="lazy" />
      : <div class="card-thumb-fallback" aria-hidden="true">{title.slice(0, 1)}</div>
    }
  </div>
  <div class="card-body">
    {category && <span class="card-category">{category}</span>}
    <h3 class="card-title">{title}</h3>
    {excerpt && <p class="card-excerpt">{excerpt}</p>}
  </div>
</a>
