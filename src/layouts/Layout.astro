---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
}
const { title, description, image, canonicalUrl } = Astro.props;
const siteTitle = 'EpisodeLens';
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://episodelens.com';
// الصورة هنا تأتي من الصفحة المستدعية كرابط مطلق بالفعل (resolveArticleImage + siteUrl)
// عندما تكون الصفحة مقالًا؛ لصفحات أخرى بلا صورة محددة نستخدم شعار الموقع كاحتياط.
const resolvedOgImage = image && image.trim() ? image.trim() : siteUrl + '/images/logo.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteTitle}</title>
    <meta name="description" content={description} />
    {/* max-image-preview:large هو الشرط الفعلي الذي تتحقق منه Google قبل عرض أي
       صفحة بصورة كبيرة في Google Discover — بدونه تبقى الصور صغيرة أو مخفية تمامًا */}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalUrl || siteUrl + Astro.url.pathname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="900" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/global.css" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JCRN9S6WY0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-JCRN9S6WY0');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">Episode<span>Lens</span></a>
      <nav class="site-nav">
        <a href="/">Hollywood</a>
        <a href="/">Music</a>
        <a href="/">TV</a>
        <a href="/">Awards</a>
        <a href="/">Scandals</a>
        <a href="/quizzes/">Quizzes</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} EpisodeLens. All rights reserved.</p>
    </footer>
  </body>
</html>
