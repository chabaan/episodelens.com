---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import LangSwitcher from "../../../components/LangSwitcher.astro";
import { trending } from "../../../data/trending.js";

export function getStaticPaths() {
  return trending.map((t) => ({
    params: { slug: t.slug },
    props: { item: t },
  }));
}

const { item } = Astro.props;
const a = item.en;
---
<Layout title={`${a.title} — Mashhad`} description={a.summary} lang="en" path={`trending/${item.slug}`}>
  <Header lang="en" path={`trending/${item.slug}`} />

  <article class="section">
    <div class="container" style="max-width:720px">
      <span class={`flag-badge ${item.flag}`}>{item.flag === "us" ? "US" : "UK"}</span>
      <span class="meta" style="margin-inline-start:8px">{item.year} · ★ {item.rating}</span>
      <h1 style="font-size:32px; margin:16px 0 24px;">{a.title}</h1>
      <p style="font-size:17px; color:var(--text-dim); margin-bottom:28px;">{a.summary}</p>
      <p style="font-size:16px; line-height:1.8;">{a.body}</p>

      <div style="margin-top:40px; padding-top:20px; border-top:1px solid var(--line);">
        <a href="/en/#trending">← Back to trending</a>
      </div>
    </div>
  </article>

  <footer class="site-footer">
    <div class="container">© 2026 Mashhad</div>
  </footer>
</Layout>
