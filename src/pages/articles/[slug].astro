---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  // ملاحظة: مجموعات النوع "data" في Astro تُعرَّف بـ id (اسم الملف)
  // وليس slug، لذلك نستخدم article.id هنا كمعرّف الرابط.
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article }
  }));
}

const { article } = Astro.props;
const { title, metaDescription, category, author, image, altText, hashtags, html, publishDate } = article.data;
const formattedDate = publishDate
  ? new Date(publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---
<Layout title={title} description={metaDescription} image={image}>
  <div class="article-header">
    {category && <span class="article-category">{category}</span>}
    <h1 class="article-title">{title}</h1>
    <p class="article-byline">
      {author && <span>By {author}</span>}
      {author && formattedDate && <span> · </span>}
      {formattedDate && <span>{formattedDate}</span>}
    </p>
  </div>

  {image && <img class="article-image" src={image} alt={altText || title} />}

  <article class="article-body" set:html={html} />

  {hashtags && hashtags.length > 0 && (
    <div class="article-hashtags">
      {hashtags.map((tag: string) => <span>{tag}</span>)}
    </div>
  )}
</Layout>
